# Admin credentials
ADMIN_USER=admin
ADMIN_PASS=admin

# Backup configuration
BACKUP_ENABLED=true
BACKUP_DROPBOX_REFRESH_TOKEN=your_long_lived_refresh_token_here
BACKUP_DROPBOX_APP_KEY=your_dropbox_app_key_here
BACKUP_DROPBOX_APP_SECRET=your_dropbox_app_secret_here
BACKUP_DROPBOX_FOLDER=/Backup
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *
RESTORE_LATEST_BACKUP=false